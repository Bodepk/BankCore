# Copiá este archivo a ".env" (sin .example) y completá tus propios valores.
# El archivo ".env" real NUNCA se commitea (está en .gitignore).

# ===== Base de datos =====
DB_USERNAME=bankuser
DB_PASSWORD=bankpass
DB_URL=jdbc:postgresql://localhost:5435/bankdb

# ===== JWT =====
# Generá un secret propio y largo para tu entorno, por ejemplo con:
#   openssl rand -hex 32
JWT_SECRET=poné_aca_un_secret_largo_y_aleatorio_propio
